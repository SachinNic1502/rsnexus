# Base URL of the RSNexus backend API, including the version segment.
# The pricing page reads this directly in the browser; it is never hardcoded.
# Example: https://api.rsnexus.com/api/v1
NEXT_PUBLIC_API_BASE_URL=

# Optional. Only used by the authenticated server-side path
# (app/api/pricing/route.ts), which the pricing page no longer calls because
# GET /pricing is public. Leave empty unless that route is put back behind auth.
PRICING_API_ACCESS_TOKEN=

# Contact form mailbox credentials (app/api/contact/route.ts)
EMAIL_USER=
EMAIL_PASS=
